# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf
# Workers add lessons to the notes in parallel: keep both sides' lines on a
# merge (tools/check_notes.py catches a lesson both sides edited)
docs/matching-notes.md   merge=union
docs/matching-notes/*.md merge=union
